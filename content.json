                "flex-direction": "column",
                "align-items": "center",
                "gap": "0.5rem",
                "numero-experiencia": {
                    "nombre": "numero",
                    "texto": "2",
                    "font-size": "2.5rem",
                    "font-weight": "800",
                    "color": "#f59e0b"

{
    "nombre": "OMNIVERSE V10 - THE ARCHITECT'S MASTERPIECE",
    "background": "$variables.theme.bg",
    "color": "$variables.theme.text",
    "font-family": "'Inter', system-ui, sans-serif",
    "min-height": "100vh",
    "overflow": "hidden",
    "perspective": "1000px",
    "_seeds": {
        "glass-panel": {
            "backdrop-filter": "blur(40px) saturate(150%)",
            "background": "rgba(255, 255, 255, 0.02)",
            "border": "1px solid rgba(255, 255, 255, 0.08)",
            "border-radius": "32px",
            "box-shadow": "0 20px 80px rgba(0,0,0,0.8)"
        },
        "neon-glow": {
            "color": "$variables.theme.accent",
            "text-shadow": "0 0 10px $variables.theme.accent_glow, 0 0 30px $variables.theme.accent_glow"
        }
    },
    "variables": {
        "theme": {
            "bg": "#010103",
            "text": "#ffffff",
            "accent": "#00f0ff",
            "accent_glow": "rgba(0, 240, 255, 0.5)",
            "glass": "rgba(255, 255, 255, 0.03)"
        },
        "state": {
            "active_module": "SYMPHONY",
            "intensity": 1.0,
            "phys_x": 50,
            "phys_y": 50
        }
    },
    "templates": {
        "NeuralCore": {
            "position": "absolute",
            "width": "{{size}}",
            "height": "{{size}}",
            "border-radius": "50%",
            "background": "{{color}}",
            "filter": "blur(math({{size}} / 2)px)",
            "opacity": "math(0.2 * $variables.state.intensity)",
            "left": "math(50 + cos(time * {{speed}} + {{offset}}) * 35)%",
            "top": "math(50 + sin(time * {{speed}} * 0.8 + {{offset}}) * 35)%",
            "transform": "scale(math(1 + sin(time) * 0.2))"
        },
        "StudioTab": {
            "padding": "12px 20px",
            "border-radius": "100px",
            "border": "1px solid math($variables.state.active_module === '{{label}}' ? '$variables.theme.accent' : 'rgba(255,255,255,0.05)')",
            "background": "math($variables.state.active_module === '{{label}}' ? 'rgba(0, 240, 255, 0.1)' : 'transparent')",
            "color": "math($variables.state.active_module === '{{label}}' ? '$variables.theme.accent' : '#555')",
            "cursor": "pointer",
            "transition": "all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1)",
            "texto": "{{label}}",
            "font-size": "0.6rem",
            "font-weight": "800",
            "letter-spacing": "2px",
            "onClick": [
                { "type": "set", "path": "variables.state.active_module", "value": "{{label}}" }
            ],
            "hover": {
                "border-color": "$variables.theme.accent",
                "color": "#fff"
            }
        },
        "FeatureCard": {
            "_seed": "glass-panel",
            "flex": "1",
            "padding": "30px",
            "display": "flex",
            "flex-direction": "column",
            "gap": "12px",
            "icon": { "texto": "{{icon}}", "font-size": "2rem" },
            "title": { "texto": "{{title}}", "font-weight": "800", "font-size": "1.1rem" },
            "desc": { "texto": "{{desc}}", "opacity": "0.4", "font-size": "0.85rem", "line-height": "1.6" },
            "hover": {
                "transform": "translateY(-10px)",
                "background": "rgba(255,255,255,0.06)",
                "border-color": "$variables.theme.accent"
            }
        }
    },
    "background_orchestrator": {
        "position": "fixed",
        "inset": "0",
        "z-index": "-1",
        "core_1": { "_template": "NeuralCore", "props": { "size": "600px", "color": "#0a1a3a", "speed": "0.4", "offset": "0" } },
        "core_2": { "_template": "NeuralCore", "props": { "size": "400px", "color": "#1a0a3a", "speed": "0.6", "offset": "3" } },
        "grid": {
            "position": "absolute",
            "inset": "0",
            "background-image": "radial-gradient(rgba(0,240,255,0.05) 1px, transparent 1px)",
            "background-size": "40px 40px",
            "opacity": "0.3"
        }
    },
    "workspace": {
        "display": "flex",
        "flex-direction": "column",
        "align-items": "center",
        "justify-content": "flex-start",
        "min-height": "100vh",
        "padding": "120px 60px 60px",
        "gap": "60px",
        "navigation": {
            "display": "flex",
            "gap": "12px",
            "padding": "8px",
            "border-radius": "100px",
            "background": "rgba(255,255,255,0.02)",
            "border": "1px solid rgba(255,255,255,0.05)",
            "position": "fixed",
            "top": "40px",
            "z-index": "1000",
            "backdrop-filter": "blur(20px)",
            "item_1": { "_template": "StudioTab", "props": { "label": "SYMPHONY" } },
            "item_2": { "_template": "StudioTab", "props": { "label": "NEURAL" } },
            "item_3": { "_template": "StudioTab", "props": { "label": "KINETIC" } }
        },
        "liquid_interface": {
            "_seed": "glass-panel",
            "width": "100%",
            "max-width": "900px",
            "padding": "60px",
            "display": "flex",
            "flex-direction": "column",
            "gap": "40px",
            "transform": "rotateX(math(my * 10 - 5)deg) rotateY(math(mx * 10 - 5)deg)",
            "transition": "transform 0.1s ease-out",
            "header": {
                "display": "flex",
                "justify-content": "space-between",
                "align-items": "flex-start",
                "meta": {
                    "display": "flex",
                    "flex-direction": "column",
                    "gap": "8px",
                    "title": {
                        "texto": "OMNIVERSE_ARCHIVE",
                        "font-size": "2.5rem",
                        "font-weight": "900",
                        "letter-spacing": "-1px",
                        "_seed": "neon-glow"
                    },
                    "subtitle": {
                        "texto": "MODULAR_LOGIC_UNIT // 00.9.10",
                        "font-size": "0.6rem",
                        "opacity": "0.3",
                        "letter-spacing": "3px"
                    }
                },
                "status_indicator": {
                    "width": "12px",
                    "height": "12px",
                    "border-radius": "50%",
                    "background": "#4ade80",
                    "box-shadow": "0 0 20px #4ade80",
                    "transform": "scale(math(1 + sin(time * 5) * 0.3))"
                }
            },
            "canvas_area": {
                "height": "300px",
                "border": "1px dashed rgba(255,255,255,0.1)",
                "border-radius": "24px",
                "background": "rgba(0,0,0,0.2)",
                "display": "flex",
                "align-items": "center",
                "justify-content": "center",
                "overflow": "hidden",
                "relative_layer": {
                    "position": "relative",
                    "width": "100%",
                    "height": "100%",
                    "kinetic_node": {
                        "width": "80px",
                        "height": "80px",
                        "border-radius": "20px",
                        "background": "linear-gradient(135deg, $variables.theme.accent, #ff00ff)",
                        "position": "absolute",
                        "left": "math(mx * 100)%",
                        "top": "math(my * 100)%",
                        "transform": "translate(-50%, -50%) rotate(math(time * 50)deg)",
                        "box-shadow": "0 0 50px rgba(0,240,255,0.3)",
                        "onMouseEnter": [ { "type": "set", "path": "variables.state.intensity", "value": "2.0" } ],
                        "onMouseLeave": [ { "type": "set", "path": "variables.state.intensity", "value": "1.0" } ]
                    }
                }
            },
            "description": {
                "texto": "Module: $variables.state.active_module. High-precision transcription engine running at 60FPS. All visual parameters are derived from high-frequency math strings resolved in the main execution loop.",
                "font-size": "0.8rem",
                "line-height": "1.7",
                "opacity": "0.5"
            }
        },
        "features_grid": {
            "width": "100%",
            "max-width": "1000px",
            "display": "flex",
            "gap": "20px",
            "feat_1": { "_template": "FeatureCard", "props": { "icon": "⚛", "title": "Surgical Updates", "desc": "Updates only the properties that changed, preventing massive layout recalculations." } },
            "feat_2": { "_template": "FeatureCard", "props": { "icon": "⚡", "title": "60FPS Engine", "desc": "Optimized math compilation ensures fluid interactions even with complex physics." } },
            "feat_3": { "_template": "FeatureCard", "props": { "icon": "∞", "title": "Infinite Logic", "desc": "JSON nodes can contain deep logical expressions and lifecycle event hooks." } }
        },
        "physics_playground": {
            "_seed": "glass-panel",
            "width": "100%",
            "max-width": "1000px",
            "height": "500px",
            "display": "flex",
            "flex-direction": "column",
            "align-items": "center",
            "justify-content": "center",
            "background": "#000",
            "overflow": "hidden",
            "relative": {
                "position": "relative",
                "width": "100%", "height": "100%",
                "text": {
                    "position": "absolute", "top": "20px", "left": "20px", "texto": "// PHYSICS_STRESS_TEST", "font-size": "0.6rem", "opacity": "0.3", "font-family": "monospace"
                },
                "particle_1": {
                    "width": "120px", "height": "120px", "border-radius": "50%", "background": "rgba(0, 240, 255, 0.2)",
                    "position": "absolute", "filter": "blur(40px)",
                    "left": "math(50 + sin(time) * 30)%",
                    "top": "math(50 + cos(time * 1.5) * 20)%"
                },
                "floating_card": {
                    "width": "200px", "padding": "20px", "background": "rgba(255,255,255,0.05)", "border-radius": "16px",
                    "position": "absolute", "z-index": "10", "border": "1px solid rgba(255,255,255,0.1)",
                    "left": "math(50 + sin(time * 0.5) * 25)%",
                    "top": "math(50 + cos(time * 0.7) * 15)%",
                    "transform": "translate(-50%, -50%) rotate(math(sin(time) * 10)deg)",
                    "title": { "texto": "KINETIC_UNIT", "font-weight": "800", "font-size": "0.7rem", "text-align": "center" }
                }
            }
        },
        "footer": {
            "padding": "40px", "opacity": "0.2", "font-size": "0.6rem", "letter-spacing": "2px",
            "texto": "© 2026 OMNIVERSE STUDIOS // DESIGNED BY TRANSMUTATION"
        }
    }
}

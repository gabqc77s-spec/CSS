{
    "nombre": "NEXUS V6 IMMERSIVE",
    "background-color": "$colors.bg",
    "color": "$colors.text",
    "font-family": "'Inter', system-ui, sans-serif",
    "min-height": "100vh",
    "overflow-x": "hidden",
    "variables": {
        "colors": {
            "bg": "#020204",
            "text": "#ffffff",
            "accent": "#00f0ff",
            "accent2": "#ff003c",
            "glass": "rgba(255,255,255,0.03)"
        }
    },
    "animations": {
        "pulse": {
            "0%": { "opacity": "0.3" },
            "50%": { "opacity": "1" },
            "100%": { "opacity": "0.3" }
        }
    },
    "hero": {
        "nombre": "Living Hero",
        "height": "100vh",
        "display": "flex",
        "flex-direction": "column",
        "align-items": "center",
        "justify-content": "center",
        "text-align": "center",
        "position": "relative",
        "background": "radial-gradient(circle at calc(var(--nexus-mouse-x) * 1px) calc(var(--nexus-mouse-y) * 1px), rgba(0, 240, 255, 0.15) 0%, transparent 40%)",
        "title": {
            "texto": "NEXUS V6",
            "font-size": "calc(8rem + (var(--nexus-scroll) * 0.1px))",
            "font-weight": "900",
            "letter-spacing": "-0.05em",
            "transform": "translateY(calc(var(--nexus-scroll) * -0.5px))",
            "opacity": "calc(1 - (var(--nexus-scroll) / 1000))"
        },
        "subtitle": {
            "texto": "The Impossible is Now Reactive",
            "font-size": "1.5rem",
            "opacity": "0.5",
            "margin-top": "20px",
            "letter-spacing": "0.5em"
        },
        "cursor-follow": {
            "nombre": "Cursor Glow",
            "position": "fixed",
            "width": "100px",
            "height": "100px",
            "background": "$colors.accent",
            "filter": "blur(80px)",
            "border-radius": "50%",
            "top": "calc(var(--nexus-mouse-y) * 1px - 50px)",
            "left": "calc(var(--nexus-mouse-x) * 1px - 50px)",
            "pointer-events": "none",
            "z-index": "10"
        }
    },
    "cards": {
        "nombre": "Reactive Grid",
        "display": "grid",
        "grid-template-columns": "repeat(3, 1fr)",
        "gap": "2rem",
        "padding": "100px 10%",
        "responsive": {
            "0": { "grid-template-columns": "1fr" },
            "1024": { "grid-template-columns": "repeat(3, 1fr)" }
        },
        "card1": {
            "_seed": "glass",
            "padding": "3rem",
            "border-radius": "32px",
            "transform": "perspective(1000px) rotateX(calc((var(--nexus-mouse-y) - 500) * -0.02deg)) rotateY(calc((var(--nexus-mouse-x) - 500) * 0.02deg))",
            "h": { "texto": "Environmental Mapping", "font-weight": "800", "margin-bottom": "1rem" },
            "p": { "texto": "Direct CSS variable injection: Scroll, Mouse, Time.", "opacity": "0.4" }
        },
        "card2": {
            "_seed": "glass",
            "padding": "3rem",
            "border-radius": "32px",
            "transform": "translateY(calc(var(--nexus-scroll) * 0.1px))",
            "h": { "texto": "Meta-Seeds", "font-weight": "800", "margin-bottom": "1rem" },
            "p": { "texto": "Architectural patterns expanded into native CSS.", "opacity": "0.4" }
        },
        "card3": {
            "_seed": "glass",
            "padding": "3rem",
            "border-radius": "32px",
            "h": { "texto": "Infinite Potential", "font-weight": "800", "margin-bottom": "1rem" },
            "p": { "texto": "Your imagination is the only boundary.", "opacity": "0.4" },
            "timer": {
                "texto": "SYSTEM_TIME: 0.00",
                "margin-top": "2rem",
                "font-family": "'JetBrains Mono', monospace",
                "font-size": "0.8rem",
                "color": "$colors.accent",
                "animation": "pulse 2s infinite"
            }
        }
    }
}
